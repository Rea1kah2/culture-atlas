{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Self-hosted deploy config for Culture Atlas — this file IS the real
  // config now (previously a build-only placeholder that a managed platform's
  // external CI overwrote at deploy time; that platform is no longer used).
  "name": "culture-atlas",

  // The Worker entry is the TanStack Start SSR server bundle —
  // `vite build` emits dist/server/server.js (`export default { fetch }`).
  "main": "dist/server/server.js",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // SSR asset routing: static files in dist/client serve directly (asset-first);
  // any non-asset path — incl. "/" — falls through to the SSR Worker (no
  // index.html ships, so "/" never matches an asset). Do NOT set
  // run_worker_first:true — that makes the Worker intercept /assets/* and 404
  // them (the SSR handler has no asset route).
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  // D1 database (Culture Atlas destinations/stories/experiences/marketplace
  // data). Schema lives in migrations/000N_*.sql (additive) — apply with
  // `bun run db:migrate` (wraps `wrangler d1 migrations apply --remote`).
  // TODO: replace database_id below with the real ID once the D1 database is
  // created (Cloudflare dashboard → Workers & Pages → D1 → Create database,
  // name it "culture-atlas" — or `wrangler d1 create culture-atlas`).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "culture-atlas",
      "database_id": "REPLACE_WITH_REAL_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
